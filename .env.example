APP_NAME=Enlix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# En producción: APP_ENV=production, APP_DEBUG=false, APP_URL=https://enlix.pe

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# En producción se usa MySQL (cPanel):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Solo en producción (requiere HTTPS activo):
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En local queda en 'log' (los correos se escriben en storage/logs, no se
# envían de verdad). En producción, correo de cPanel vía SMTP:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps      <- SSL implícito (puerto 465). Ojo: Laravel 12 ya
#                              no usa MAIL_ENCRYPTION, el equivalente es esto.
#   MAIL_HOST=mail.enlix.pe (o el que indique cPanel)
#   MAIL_PORT=465
#   MAIL_USERNAME=         (la cuenta de correo completa, ej. servicios@enlix.pe)
#   MAIL_PASSWORD=
#   MAIL_FROM_ADDRESS=servicios@enlix.pe
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Izipay (pasarela de pagos, plataforma micuentaweb.pe) ──
# Credenciales desde el Back Office de Izipay (Configuración > Tienda > Claves de API).
# Usa las credenciales de TEST mientras desarrollas; cambia a producción solo en el servidor final.
IZIPAY_USERNAME=
IZIPAY_PASSWORD=
IZIPAY_PUBLIC_KEY=
IZIPAY_SHA256_KEY=
IZIPAY_BASE_URL=https://api.micuentaweb.pe
IZIPAY_CURRENCY=PEN
# Casi nunca hace falta tocar estos tres (tienen default en config/izipay.php):
# IZIPAY_JS_CLIENT_URL=https://static.micuentaweb.pe/static/js/krypton-client/V4.0/stable/kr-payment-form.min.js
# IZIPAY_CONNECT_TIMEOUT=5
# IZIPAY_TIMEOUT=15

# true precarga el modal de compra con datos de prueba (Juan Perez...).
# Heredado del flujo viejo de /productos (un solo producto); ese modal ya no
# existe ahí (ver PROJECT_CONTEXT.md), así que hoy esta variable no tiene
# ningún efecto visible. Se deja documentada por si se reutiliza en /checkout.
IZIPAY_AUTOLLENAR_TEST=false

# ── Tienda (config/tienda.php) ──
# Recibe el aviso por correo de cada pedido pagado. Vacío = no se manda ese
# segundo correo (el de confirmación al cliente sí se manda siempre).
ADMIN_EMAIL=

# Costo de envío para pedidos con entrega a domicilio (el recojo en tienda
# nunca cobra envío). 'gratis' no cobra nada; 'fijo' cobra siempre
# ENVIO_TARIFA_FIJA_CENTIMOS sin importar distrito/peso.
ENVIO_MODO=gratis
ENVIO_TARIFA_FIJA_CENTIMOS=0
